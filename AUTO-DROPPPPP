        local countLblRow = mkLbl(rowBtn, "x" .. tostring(itmData.Count), 10, true, isSel and Color3.fromRGB(134, 239, 172) or Color3.fromRGB(74, 222, 128), Enum.TextXAlignment.Right)
        countLblRow.Position = UDim2.new(1, -85, 0, 0)
        countLblRow.Size = UDim2.new(0, 36, 1, 0)
        countLblRow.AutomaticSize = Enum.AutomaticSize.None

        -- Badge DROP / SKIP
        local checkBtn = Instance.new("TextButton")
        checkBtn.Size = UDim2.new(0, 42, 1, -6)
        checkBtn.Position = UDim2.new(1, -46, 0, 3)
        checkBtn.BackgroundColor3 = isSel and C.ACCENT or C.CARD
        checkBtn.Text = isSel and "DROP" or "SKIP"
        checkBtn.Font = Enum.Font.GothamBold
        checkBtn.TextSize = 9
        checkBtn.TextColor3 = isSel and Color3.new(1, 1, 1) or C.MUTED
        checkBtn.Parent = rowBtn
        mkCorner(checkBtn, 4)

        local function toggleSelection()
            DropConfig.SelectedItems[itmData.Key] = not DropConfig.SelectedItems[itmData.Key]
            local cur = DropConfig.SelectedItems[itmData.Key]
            
            rowBtn.BackgroundColor3 = cur and C.SEL or C.PANEL
            local st = rowBtn:FindFirstChildOfClass("UIStroke")
            if st then
                st.Color = cur and C.ACCENT or C.BORDER
                st.Thickness = cur and 1.2 or 1
            end
            
            checkBtn.BackgroundColor3 = cur and C.ACCENT or C.CARD
            checkBtn.Text = cur and "DROP" or "SKIP"
            checkBtn.TextColor3 = cur and Color3.new(1, 1, 1) or C.MUTED
            nameLbl.TextColor3 = cur and Color3.new(1, 1, 1) or C.TEXT
            nameLbl.Font = cur and Enum.Font.GothamBold or Enum.Font.Gotham
            countLblRow.TextColor3 = cur and Color3.fromRGB(134, 239, 172) or Color3.fromRGB(74, 222, 128)
        end

        rowBtn.MouseButton1Click:Connect(toggleSelection)
        checkBtn.MouseButton1Click:Connect(toggleSelection)
    end

    if count == 0 then
        local emptyLbl = mkLbl(itemListScroll, "Tas Anda sedang kosong...", 11, false, C.MUTED, Enum.TextXAlignment.Center)
        emptyLbl.Size = UDim2.new(1, 0, 0, 30); emptyLbl.AutomaticSize = Enum.AutomaticSize.None
    end
end

