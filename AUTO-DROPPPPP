end

-- ============================================================
--  BACKPACK INSPECTOR & SCANNER
-- ============================================================
local function getItemInfo(itm)
    local name = itm.Name
    local rarity = "COMMON"

    local attrName = itm:GetAttribute("CrystalName") or itm:GetAttribute("DisplayName") or itm:GetAttribute("RuneName")
    if attrName and tostring(attrName) ~= "" then name = tostring(attrName) end

    local attrTier = itm:GetAttribute("Tier")
    if attrTier and TierMap[tonumber(attrTier)] then rarity = TierMap[tonumber(attrTier)] end

    local attrRarity = itm:GetAttribute("Rarity") or itm:GetAttribute("TierName")
    if attrRarity and RarityColors[tostring(attrRarity):upper()] then
        rarity = tostring(attrRarity):upper()
    end

    if rarity == "COMMON" then
        local uname = name:upper()
        if uname:find("QUASAR") then rarity = "QUASAR"
        elseif uname:find("PULSAR") then rarity = "PULSAR"
        elseif uname:find("EMPYREAN") then rarity = "EMPYREAN"
        elseif uname:find("MYTHIC") then rarity = "MYTHIC"
        elseif uname:find("LEGENDARY") or uname:find("LEGENDARIS") then rarity = "LEGENDARY"
        elseif uname:find("EPIC") then rarity = "EPIC"
        elseif uname:find("RARE") then rarity = "RARE"
        elseif uname:find("UNCOMMON") then rarity = "UNCOMMON"
        elseif uname:find("SECRET") or uname:find("BLOOD") then rarity = "SECRET" end
    end

    return name, rarity
end

local function scanBackpack()
    local inv = {
        Total = 0,
        ByRarity = {
            ["QUASAR"] = 0, ["PULSAR"] = 0, ["EMPYREAN"] = 0,
            ["MYTHIC"] = 0, ["LEGENDARY"] = 0, ["EPIC"] = 0,
            ["RARE"] = 0, ["UNCOMMON"] = 0, ["COMMON"] = 0,
            ["SECRET"] = 0, ["OTHER"] = 0
        },
        ByItem = {},
        List = {}
    }

    local items = {}
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then for _, itm in ipairs(bp:GetChildren()) do table.insert(items, itm) end end

    local char = LocalPlayer.Character
    if char then
        for _, itm in ipairs(char:GetChildren()) do
            if itm:IsA("Tool") then table.insert(items, itm) end
        end
    end

    for _, itm in ipairs(items) do
        local name, rarity = getItemInfo(itm)
        inv.Total = inv.Total + 1
        inv.ByRarity[rarity] = (inv.ByRarity[rarity] or 0) + 1

        local key = rarity .. "::" .. name
        if not inv.ByItem[key] then
            inv.ByItem[key] = { Rarity = rarity, Name = name, Count = 0, Key = key }
        end
        inv.ByItem[key].Count = inv.ByItem[key].Count + 1
    end

    for _, data in pairs(inv.ByItem) do table.insert(inv.List, data) end

    table.sort(inv.List, function(a, b)
        local orderA = RarityOrder[a.Rarity] or 99
        local orderB = RarityOrder[b.Rarity] or 99
        if orderA ~= orderB then return orderA < orderB end
        if a.Count ~= b.Count then return a.Count > b.Count end
        return a.Name < b.Name
    end)

    return inv
end

-- ============================================================
--  MAIN DROP LOOP
-- ============================================================
local startDropBtnRef = nil
local dropThread = nil

local function stopDropLoop()
    DropConfig.Running = false
    DropStats.StatusText = "IDLE (Dihentikan)"
    if startDropBtnRef then
        startDropBtnRef.Text = "START AUTO DROP"
        startDropBtnRef.BackgroundColor3 = Color3.fromRGB(34, 197, 94) -- Hijau
    end
end

local function startDropLoop()
    if DropConfig.Running then return end
    DropConfig.Running = true
    DropStats.SessionDropped = 0
    DropStats.StatusText = "DROPPING..."

    if startDropBtnRef then
        startDropBtnRef.Text = "STOP AUTO DROP"
        startDropBtnRef.BackgroundColor3 = Color3.fromRGB(239, 68, 68) -- Merah
    end

    dropThread = task.spawn(function()
        local dropRemote = getDropRemote()

        while DropConfig.Running do
            -- Cek Limit
            if DropConfig.LimitEnabled and DropStats.SessionDropped >= DropConfig.LimitAmount then
                stopDropLoop()
                DropStats.StatusText = string.format("LIMIT TERCAPAI (%d/%d)", DropStats.SessionDropped, DropConfig.LimitAmount)
                pcall(function()
                    StarterGui:SetCore("SendNotification", {
                        Title = "Auto Drop Selesai!",
                        Text = string.format("Limit drop %d Crystal telah tercapai!", DropConfig.LimitAmount),
                        Duration = 4
                    })
                end)
                break
            end

            local targetTools = {}
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if bp then
                for _, itm in ipairs(bp:GetChildren()) do table.insert(targetTools, itm) end
            end
            local char = LocalPlayer.Character
            if char then
                for _, itm in ipairs(char:GetChildren()) do
                    if itm:IsA("Tool") then table.insert(targetTools, itm) end
                end
            end

            local itemsToDrop = {}
            for _, itm in ipairs(targetTools) do
                local name, rarity = getItemInfo(itm)
                local key = rarity .. "::" .. name

                if DropConfig.SelectedItems[key] == true then
                    table.insert(itemsToDrop, { Item = itm, Name = name, Rarity = rarity })
                end
            end

            if #itemsToDrop == 0 then
                DropStats.StatusText = "IDLE (Tidak ada crystal yang dicentang)"
                task.wait(0.4)
            else
                for _, dropData in ipairs(itemsToDrop) do
                    if not DropConfig.Running then break end
                    if DropConfig.LimitEnabled and DropStats.SessionDropped >= DropConfig.LimitAmount then
                        break
                    end

                    local itm = dropData.Item
                    if itm and itm.Parent then
                        local dropped = false

                        -- 1. Fire Remote
                        if dropRemote then
                            pcall(function() dropRemote:FireServer(dropData.Name) end)
                            pcall(function() dropRemote:FireServer(itm.Name) end)
                            dropped = true
                        end

                        -- 2. Fallback Equip & Drop
                        if itm.Parent == bp and LocalPlayer.Character then
                            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                            if hum then
                                hum:EquipTool(itm)
                                task.wait(0.01)
                                if itm.Parent == LocalPlayer.Character then
                                    itm.Parent = Workspace
                                    dropped = true
                                end
                            end
                        end

                        if dropped then
                            DropStats.TotalDropped = DropStats.TotalDropped + 1
                            DropStats.SessionDropped = DropStats.SessionDropped + 1
                            DropStats.LastDropped = dropData.Name
                        end

                        if DropConfig.DropDelay > 0 then
                            task.wait(DropConfig.DropDelay)
                        end
                    end
                end
            end

            task.wait(DropConfig.DropDelay > 0 and DropConfig.DropDelay or 0.04)
        end

        dropThread = nil
    end)
end

