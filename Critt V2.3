local function bindBackpackEvents()
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if bp then
        bp.ChildAdded:Connect(function() 
            task.wait(0.1)
            if UI.RenderBackpack and UI.Pages[2].Visible then UI.RenderBackpack() end
            if UI.RenderFavPage and UI.Pages[4].Visible then UI.RenderFavPage() end
        end)
        bp.ChildRemoved:Connect(function() 
            task.wait(0.1)
            if UI.RenderBackpack and UI.Pages[2].Visible then UI.RenderBackpack() end
            if UI.RenderFavPage and UI.Pages[4].Visible then UI.RenderFavPage() end
        end)
    end
end
bindBackpackEvents()

LocalPlayer.CharacterAdded:Connect(function()
    task.wait(1)
    if PlayerConfig.FlyEnabled then startFly() end
    bindBackpackEvents()
end)

