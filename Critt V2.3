    mkCorner(flyToggleBtn, 5); mkStroke(flyToggleBtn, Theme.BORDER, 1)

    local flyCtrlLbl = mkLbl(flySec, "Kontrol: W,A,S,D (Gerak) | Space (Naik) | Shift/Ctrl (Turun)", 10, false, Theme.MUTED)
    flyCtrlLbl.Position = UDim2.new(0, 0, 0, 26); flyCtrlLbl.Size = UDim2.new(1, 0, 0, 14); flyCtrlLbl.AutomaticSize = Enum.AutomaticSize.None

    local flyInfoLbl = mkLbl(flySec, "Kecepatan Fly: " .. tostring(PlayerConfig.FlySpeed), 11, true, Color3.fromRGB(90, 210, 255))
    flyInfoLbl.Position = UDim2.new(0, 0, 0, 44); flyInfoLbl.Size = UDim2.new(1, 0, 0, 16); flyInfoLbl.AutomaticSize = Enum.AutomaticSize.None

    local flyBtnRow = Instance.new("Frame")
    flyBtnRow.BackgroundTransparency = 1; flyBtnRow.Position = UDim2.new(0, 0, 0, 66); flyBtnRow.Size = UDim2.new(1, 0, 0, 26); flyBtnRow.Parent = flySec
    local flyList = Instance.new("UIListLayout"); flyList.FillDirection = Enum.FillDirection.Horizontal; flyList.Padding = UDim.new(0, 4); flyList.Parent = flyBtnRow

    local flyCustomInput = Instance.new("TextBox")
    flyCustomInput.Position = UDim2.new(0, 0, 0, 98); flyCustomInput.Size = UDim2.new(1, 0, 0, 26); flyCustomInput.BackgroundColor3 = Theme.PANEL
    flyCustomInput.PlaceholderText = "Ketik kecepatan fly kustom (cth: 120)..."; flyCustomInput.PlaceholderColor3 = Theme.MUTED; flyCustomInput.Text = tostring(PlayerConfig.FlySpeed)
    flyCustomInput.Font = Enum.Font.Gotham; flyCustomInput.TextSize = 11; flyCustomInput.TextColor3 = Theme.TEXT; flyCustomInput.ClearTextOnFocus = false; flyCustomInput.Parent = flySec
    mkCorner(flyCustomInput, 5); mkStroke(flyCustomInput, Theme.BORDER, 1)

    local function refreshFlyBtns()
        flyToggleBtn.BackgroundColor3 = PlayerConfig.FlyEnabled and Theme.GREEN or Theme.PANEL
        flyToggleBtn.Text = PlayerConfig.FlyEnabled and "FLY: ON" or "FLY: OFF"
        flyInfoLbl.Text = string.format("Kecepatan Fly: %d %s", PlayerConfig.FlySpeed, PlayerConfig.FlyEnabled and "(Aktif)" or "(Nonaktif)")
        for _, ch in ipairs(flyBtnRow:GetChildren()) do
            if ch:IsA("TextButton") then
                local isCur = (ch.Text == tostring(PlayerConfig.FlySpeed))
                ch.BackgroundColor3 = isCur and Theme.SEL or Theme.PANEL
                ch.TextColor3 = isCur and Theme.TEXT or Theme.MUTED
                local st = ch:FindFirstChildOfClass("UIStroke")
                if st then st.Color = isCur and Theme.ACCENT or Theme.BORDER end
            end
        end
    end

    flyToggleBtn.MouseButton1Click:Connect(function()
        PlayerConfig.FlyEnabled = not PlayerConfig.FlyEnabled
        if PlayerConfig.FlyEnabled then startFly() else stopFly() end
        refreshFlyBtns()
    end)

    for _, flyVal in ipairs({ 25, 50, 80, 120, 200 }) do
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(0.2, -4, 1, 0); b.BackgroundColor3 = PlayerConfig.FlySpeed == flyVal and Theme.SEL or Theme.PANEL
        b.Text = tostring(flyVal); b.Font = Enum.Font.GothamBold; b.TextSize = 10
        b.TextColor3 = PlayerConfig.FlySpeed == flyVal and Theme.TEXT or Theme.MUTED; b.Parent = flyBtnRow
        mkCorner(b, 5); mkStroke(b, PlayerConfig.FlySpeed == flyVal and Theme.ACCENT or Theme.BORDER, 1)

        b.MouseButton1Click:Connect(function()
            PlayerConfig.FlySpeed = flyVal
            flyCustomInput.Text = tostring(flyVal)
            refreshFlyBtns()
        end)
    end

    flyCustomInput:GetPropertyChangedSignal("Text"):Connect(function()
        local n = tonumber(flyCustomInput.Text)
        if n and n > 0 then PlayerConfig.FlySpeed = math.floor(n); refreshFlyBtns() end
    end)
end

