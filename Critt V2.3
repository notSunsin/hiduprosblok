    UI.RenderFavPage = renderFavPageList

    local function runBatchFavorite(targetFavState, applyFilter)
        if FavConfig.IsProcessing then return end
        FavConfig.IsProcessing = true
        favStatusLbl.Text = string.format("Memproses %s...", targetFavState and "Favorite" or "Unfavorite")
        favStatusLbl.TextColor3 = Theme.ACC_FAV

        task.spawn(function()
            local inv = scanBackpack()
            local processed = 0
            for _, item in ipairs(inv.RawItems) do
                local pass = true
                if applyFilter then
                    if FavConfig.FilterLuckOnly and not item.HasLuck then pass = false end
                    
                    if FavConfig.LuckTargetRaw > 0 then
                        if FavConfig.LuckOperator == "ABOVE" then
                            if item.Luck < FavConfig.LuckTargetRaw then pass = false end
                        elseif FavConfig.LuckOperator == "BELOW" then
                            if item.Luck > FavConfig.LuckTargetRaw then pass = false end
                        end
                    end

                    if FavConfig.TargetSize ~= "ALL" and item.Size ~= FavConfig.TargetSize then pass = false end
                end

                if pass then
                    toggleItemFavoriteRemote(item.Instance, targetFavState)
                    processed = processed + 1
                    task.wait(0.01)
                end
            end

            favStatusLbl.Text = string.format("Selesai! %d item berhasil di-%s.", processed, targetFavState and "Favoritkan" or "Unfavoritkan")
            favStatusLbl.TextColor3 = Color3.fromRGB(74, 222, 128)
            FavConfig.IsProcessing = false
            renderFavPageList()
        end)
    end

    favAllBtn.MouseButton1Click:Connect(function() runBatchFavorite(true, false) end)
    unfavAllBtn.MouseButton1Click:Connect(function() runBatchFavorite(false, false) end)
    batchFavFilterBtn.MouseButton1Click:Connect(function() runBatchFavorite(true, true) end)
    batchUnfavFilterBtn.MouseButton1Click:Connect(function() runBatchFavorite(false, true) end)
end

