local isMin = false
UI.MinBtn.MouseButton1Click:Connect(function()
    isMin = not isMin
    if isMin then
        TweenService:Create(Main, TweenInfo.new(0.2), { Size = UDim2.new(0, 420, 0, 46) }):Play()
        TabNav.Visible = false
        for _, p in ipairs(UI.Pages) do p.Visible = false end
        UI.MinBtn.Text = "+"
    else
        TabNav.Visible = true
        local cur = 1
        for i, p in ipairs(UI.Pages) do if p.Visible then cur = i; break end end
        switchTab(cur)
        TweenService:Create(Main, TweenInfo.new(0.2), { Size = UDim2.new(0, 420, 0, 600) }):Play()
        UI.MinBtn.Text = "−"
    end
end)

