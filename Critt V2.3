    local function renderFavPageList()
        local inv = scanBackpack()
        local searchQ = favSearchBox.Text:gsub("^%s+", ""):gsub("%s+$", ""):lower()

        for _, ch in ipairs(favScroll:GetChildren()) do
            if ch:IsA("Frame") then ch:Destroy() end
        end

        local count = 0
        for i, itemData in ipairs(inv.List) do
            local matchesText = (searchQ == "") or itemData.Name:lower():find(searchQ, 1, true) or itemData.Rarity:lower():find(searchQ, 1, true) or itemData.Size:lower():find(searchQ, 1, true) or itemData.LuckDisplay:lower():find(searchQ, 1, true)
            if matchesText then
                count = count + 1
                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, 0, 0, 30); row.BackgroundColor3 = Theme.PANEL; row.LayoutOrder = i; row.Parent = favScroll
                mkCorner(row, 5)

                local rBadge = Instance.new("Frame")
                rBadge.Size = UDim2.new(0, 64, 1, -4); rBadge.Position = UDim2.new(0, 2, 0, 2); rBadge.BackgroundColor3 = Theme.CARD; rBadge.Parent = row
                mkCorner(rBadge, 4)

                local rBadgeLbl = mkLbl(rBadge, itemData.Rarity, 8.5, true, RarityColors[itemData.Rarity] or Theme.TEXT, Enum.TextXAlignment.Center)
                rBadgeLbl.Size = UDim2.new(1, 0, 1, 0); rBadgeLbl.AutomaticSize = Enum.AutomaticSize.None

                local nameStr = itemData.Name
                if itemData.Size ~= "NORMAL" and itemData.Size ~= "" then nameStr = "[" .. itemData.Size .. "] " .. nameStr end
                if itemData.HasLuck then nameStr = nameStr .. string.format(" 🍀[%s]", itemData.LuckDisplay) end

                local nameLbl = mkLbl(row, nameStr, 10, false, itemData.HasLuck and Color3.fromRGB(253, 224, 71) or Theme.TEXT)
                nameLbl.Position = UDim2.new(0, 70, 0, 0); nameLbl.Size = UDim2.new(1, -165, 1, 0); nameLbl.TextTruncate = Enum.TextTruncate.AtEnd; nameLbl.AutomaticSize = Enum.AutomaticSize.None

                local countLbl = mkLbl(row, "x" .. tostring(itemData.Count), 10, true, Color3.fromRGB(74, 222, 128), Enum.TextXAlignment.Right)
                countLbl.Position = UDim2.new(1, -92, 0, 0); countLbl.Size = UDim2.new(0, 28, 1, 0); countLbl.AutomaticSize = Enum.AutomaticSize.None

                local actionBtn = Instance.new("TextButton")
                actionBtn.Size = UDim2.new(0, 58, 1, -4); actionBtn.Position = UDim2.new(1, -62, 0, 2)
                actionBtn.BackgroundColor3 = itemData.IsFavorite and Color3.fromRGB(75, 85, 99) or Color3.fromRGB(161, 98, 7)
                actionBtn.Text = itemData.IsFavorite and "❌ Unfav" or "⭐ Fav"
                actionBtn.Font = Enum.Font.GothamBold; actionBtn.TextSize = 9.5; actionBtn.TextColor3 = Color3.new(1, 1, 1); actionBtn.Parent = row
                mkCorner(actionBtn, 4)

                actionBtn.MouseButton1Click:Connect(function()
                    local newFavState = not itemData.IsFavorite
                    itemData.IsFavorite = newFavState
                    for _, singleItem in ipairs(itemData.Items) do
                        toggleItemFavoriteRemote(singleItem.Instance, newFavState)
                    end
                    renderFavPageList()
                end)
            end
        end

        if count == 0 then
            local emptyLbl = mkLbl(favScroll, searchQ == "" and "Tidak ada item di tas." or "Tidak ada crystal yang cocok dengan filter.", 11, false, Theme.MUTED, Enum.TextXAlignment.Center)
