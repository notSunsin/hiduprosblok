    sessBreakdownLbl.Position = UDim2.new(0, 0, 0, 64); sessBreakdownLbl.Size = UDim2.new(1, 0, 0, 16); sessBreakdownLbl.AutomaticSize = Enum.AutomaticSize.None

    RunService.Heartbeat:Connect(function()
        if Stats.SessionStartTime and Config.Running then
            local elapsed = os.time() - Stats.SessionStartTime
            local hours = math.floor(elapsed / 3600); local mins = math.floor((elapsed % 3600) / 60); local secs = elapsed % 60
            local rate = (elapsed > 0) and math.floor((Stats.SessionCollected / (elapsed / 60)) * 10) / 10 or 0
            sessInfoLbl.Text = string.format("Durasi: %02d:%02d:%02d  |  Kecepatan: %.1f/mnt", hours, mins, secs, rate)
            sessTrophyLbl.Text = string.format("Total Diambil Sesi Ini: %d Crystal", Stats.SessionCollected)

            local topStr = {}
            for _, rKey in ipairs({"QUASAR", "PULSAR", "EMPYREAN", "MYTHIC", "LEGENDARY"}) do
                local count = Stats.CollectedByRarity[rKey] or 0
                if count > 0 then table.insert(topStr, string.format("%s: %d", rKey:sub(1,1) .. rKey:sub(2):lower(), count)) end
            end
            sessBreakdownLbl.Text = #topStr > 0 and ("Top Drops: " .. table.concat(topStr, " | ")) or "Top Drops: Menunggu drop tier tinggi..."
        else
            sessInfoLbl.Text = "Durasi: 00:00:00  |  Kecepatan: 0/mnt"
