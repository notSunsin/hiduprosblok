    bpSummaryLbl.Position = UDim2.new(0, 0, 0, 24); bpSummaryLbl.Size = UDim2.new(1, 0, 0, 16); bpSummaryLbl.AutomaticSize = Enum.AutomaticSize.None

    local bpSearchBox = Instance.new("TextBox")
    bpSearchBox.Position = UDim2.new(0, 0, 0, 44); bpSearchBox.Size = UDim2.new(1, 0, 0, 26); bpSearchBox.BackgroundColor3 = Theme.PANEL
    bpSearchBox.PlaceholderText = "🔍 Cari crystal di tas (cth: Verdance, Terminus, XL)..."; bpSearchBox.PlaceholderColor3 = Theme.MUTED; bpSearchBox.Text = ""
    bpSearchBox.Font = Enum.Font.Gotham; bpSearchBox.TextSize = 11; bpSearchBox.TextColor3 = Theme.TEXT; bpSearchBox.ClearTextOnFocus = false; bpSearchBox.Parent = bpSec
    mkCorner(bpSearchBox, 6); mkStroke(bpSearchBox, Theme.BORDER, 1)

    local bpScroll = Instance.new("ScrollingFrame")
    bpScroll.Position = UDim2.new(0, 0, 0, 76); bpScroll.Size = UDim2.new(1, 0, 1, -82); bpScroll.BackgroundTransparency = 1
    bpScroll.ScrollBarThickness = 3; bpScroll.ScrollBarImageColor3 = Theme.ACC2; bpScroll.BorderSizePixel = 0; bpScroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    bpScroll.AutomaticCanvasSize = Enum.AutomaticSize.Y; bpScroll.Parent = bpSec
    local bpListLay = Instance.new("UIListLayout"); bpListLay.Padding = UDim.new(0, 4); bpListLay.SortOrder = Enum.SortOrder.LayoutOrder; bpListLay.Parent = bpScroll

    local function renderBackpackList()
        local inv = scanBackpack()
        local searchQ = bpSearchBox.Text:gsub("^%s+", ""):gsub("%s+$", ""):lower()

        local sumParts = {}
        for _, rk in ipairs({"QUASAR", "PULSAR", "EMPYREAN", "MYTHIC", "LEGENDARY"}) do
            local c = inv.ByRarity[rk] or 0
            if c > 0 then table.insert(sumParts, string.format("%s: %d", rk:sub(1,1)..rk:sub(2):lower(), c)) end
        end
        bpSummaryLbl.Text = string.format("Total di Tas: %d Crystal (%s)", inv.Total, #sumParts > 0 and table.concat(sumParts, ", ") or "Kosong/Common")

        for _, ch in ipairs(bpScroll:GetChildren()) do
            if ch:IsA("Frame") then ch:Destroy() end
        end

        local displayCount = 0
        for i, itemData in ipairs(inv.List) do
            local matchesText = (searchQ == "") or itemData.Name:lower():find(searchQ, 1, true) or itemData.Rarity:lower():find(searchQ, 1, true) or itemData.Size:lower():find(searchQ, 1, true)
            if matchesText then
                displayCount = displayCount + 1
                local row = Instance.new("Frame")
                row.Size = UDim2.new(1, 0, 0, 26); row.BackgroundColor3 = Theme.PANEL; row.LayoutOrder = i; row.Parent = bpScroll
                mkCorner(row, 5)

                local rBadge = Instance.new("Frame")
                rBadge.Size = UDim2.new(0, 68, 1, -4); rBadge.Position = UDim2.new(0, 2, 0, 2); rBadge.BackgroundColor3 = Theme.CARD; rBadge.Parent = row
                mkCorner(rBadge, 4)

                local rBadgeLbl = mkLbl(rBadge, itemData.Rarity, 9, true, RarityColors[itemData.Rarity] or Theme.TEXT, Enum.TextXAlignment.Center)
                rBadgeLbl.Size = UDim2.new(1, 0, 1, 0); rBadgeLbl.AutomaticSize = Enum.AutomaticSize.None

                local nameStr = itemData.Name
                if itemData.HasLuck then
                    nameStr = nameStr .. string.format(" 🍀[%s Luck]", itemData.LuckDisplay)
                end

                local nameLbl = mkLbl(row, nameStr, 10.5, false, itemData.HasLuck and Color3.fromRGB(253, 224, 71) or Theme.TEXT)
                nameLbl.Position = UDim2.new(0, 76, 0, 0); nameLbl.Size = UDim2.new(1, -125, 1, 0); nameLbl.TextTruncate = Enum.TextTruncate.AtEnd; nameLbl.AutomaticSize = Enum.AutomaticSize.None

                local countBadge = mkLbl(row, "x" .. tostring(itemData.Count), 11, true, Color3.fromRGB(74, 222, 128), Enum.TextXAlignment.Right)
                countBadge.Position = UDim2.new(1, -44, 0, 0); countBadge.Size = UDim2.new(0, 38, 1, 0); countBadge.AutomaticSize = Enum.AutomaticSize.None
            end
        end

        if displayCount == 0 then
            local emptyLbl = mkLbl(bpScroll, searchQ == "" and "Tas Anda sedang kosong..." or "Tidak ada crystal yang cocok.", 11, false, Theme.MUTED, Enum.TextXAlignment.Center)
            emptyLbl.Size = UDim2.new(1, 0, 0, 30); emptyLbl.AutomaticSize = Enum.AutomaticSize.None
        end
    end

    refreshBpBtn.MouseButton1Click:Connect(renderBackpackList)
    bpSearchBox:GetPropertyChangedSignal("Text"):Connect(renderBackpackList)
    UI.RenderBackpack = renderBackpackList
end

