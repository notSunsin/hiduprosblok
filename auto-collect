local function getRemote(name)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild(name)
end

local function getCharacterPosition()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    return hrp and hrp.Position
end

-- Deteksi Rune
local function parseRuneInfo(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return nil, nil end
    local parent = prompt.Parent
    if not parent then return nil, nil end

    local fullText = (prompt.ObjectText .. " " .. prompt.ActionText .. " " .. parent.Name):lower()
    
    local attrName = parent:GetAttribute("RuneName") or parent:GetAttribute("DisplayName")
    if attrName then fullText = fullText .. " " .. tostring(attrName):lower() end

    for _, rune in ipairs(RuneList) do
        if fullText:find(rune.keyword, 1, true) then
            return rune.remote, rune.display
        end
    end

    return nil, nil
end

-- Deteksi Crystal & Ekstrak Rarity
local function parseCrystalInfo(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return nil, nil end
    local isRune, _ = parseRuneInfo(prompt)
    if isRune then return nil, nil end -- Jika Rune, jangan anggap Crystal

    local parent = prompt.Parent
    if not parent then return nil, nil end

    local pName = parent.Name:lower()
    local pObjText = prompt.ObjectText:lower()
    local pActText = prompt.ActionText:lower()

    local isCryst = pActText:find("pickup") or pActText:find("ambil") or pName:find("crystal") or pName:find("drop") or pObjText:find("crystal") or parent:GetAttribute("CrystalName") or parent:GetAttribute("Tier")
    if not isCryst then return nil, nil end

    local name = prompt.ObjectText ~= "" and prompt.ObjectText or parent.Name
    local rarity = "COMMON"

    local attrName = parent:GetAttribute("CrystalName") or parent:GetAttribute("DisplayName")
    if attrName and tostring(attrName) ~= "" then name = tostring(attrName) end

    local attrTier = parent:GetAttribute("Tier")
    if attrTier and TierMap[tonumber(attrTier)] then rarity = TierMap[tonumber(attrTier)] end

    local attrRarity = parent:GetAttribute("Rarity") or parent:GetAttribute("TierName")
    if attrRarity then rarity = tostring(attrRarity):upper() end

    local uname = (name .. " " .. (prompt.ObjectText or "")):upper()
    if uname:find("QUASAR") then rarity = "QUASAR"
    elseif uname:find("PULSAR") then rarity = "PULSAR"
    elseif uname:find("EMPYREAN") then rarity = "EMPYREAN"
    elseif uname:find("MYTHIC") then rarity = "MYTHIC"
    elseif uname:find("LEGENDARY") or uname:find("LEGENDARIS") then rarity = "LEGENDARY"
    elseif uname:find("EPIC") then rarity = "EPIC"
    elseif uname:find("RARE") then rarity = "RARE"
    elseif uname:find("UNCOMMON") then rarity = "UNCOMMON"
    elseif uname:find("SECRET") or uname:find("BLOOD") then rarity = "SECRET" end

    return name, rarity
end

