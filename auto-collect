local function triggerPickup(prompt, part)
    if not prompt or not prompt.Parent then return false end
    if Config.InstantHold then prompt.HoldDuration = 0 end

    if Config.ServerRemote and part then
        pcall(function()
            local rem = getRemote("CrystalHoldComplete")
            if rem then rem:FireServer(part) end
        end)
    end

    if typeof(fireproximityprompt) == "function" then
        pcall(function() fireproximityprompt(prompt, 0) end)
        return true
    end

    return pcall(function()
        prompt:InputHoldBegin()
        task.wait(Config.InstantHold and 0.01 or (prompt.HoldDuration > 0 and prompt.HoldDuration or 0.01))
        prompt:InputHoldEnd()
    end)
end

local function scanNearbyItems()
    local charPos = getCharacterPosition()
    if not charPos then return {} end

    local itemsFound = {}
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
            local isTarget = false
            local itemType = nil
            local itemKey = nil
            local displayName = nil

            -- 1. Cek Rune
            if Config.CollectRune then
                local rKey, rDisp = parseRuneInfo(prompt)
                if rKey and Config.EnabledRunes[rKey] then
                    isTarget = true
                    itemType = "RUNE"
                    itemKey = rKey
                    displayName = rDisp .. " Rune"
                end
            end

            -- 2. Cek Crystal
            if not isTarget and Config.CollectCrystal then
                local cName, cRarity = parseCrystalInfo(prompt)
                if cName and (Config.EnabledRarities[cRarity] ~= false) then
                    isTarget = true
                    itemType = "CRYSTAL"
                    itemKey = cRarity
                    displayName = string.format("[%s] %s", cRarity, cName)
                end
            end

            if isTarget then
                local part = prompt.Parent
                local pos = nil
                if part:IsA("BasePart") then pos = part.Position
                elseif part:IsA("Model") and part.PrimaryPart then pos = part.PrimaryPart.Position
                elseif part:IsA("Attachment") then pos = part.WorldPosition
                elseif part:IsA("Model") then
                    local fp = part:FindFirstChildWhichIsA("BasePart", true)
                    if fp then pos = fp.Position end
                end

                if pos then
                    local dist = (charPos - pos).Magnitude
                    if dist <= Config.MaxStuds then
                        table.insert(itemsFound, {
                            Prompt      = prompt,
                            Part        = part,
                            Position    = pos,
                            Distance    = dist,
                            ItemType    = itemType,
                            ItemKey     = itemKey,
                            DisplayName = displayName
                        })
                    end
                end
            end
        end
    end

    if Config.SortByDistance then
        table.sort(itemsFound, function(a, b) return a.Distance < b.Distance end)
    end

    return itemsFound
end

local isCollecting = false
local startBtnRef = nil

local function stopCollectLoop()
    Config.Running = false
    Stats.StatusText = "IDLE (Dihentikan)"
    if startBtnRef then
        startBtnRef.Text = "START AUTO COLLECT"
        startBtnRef.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
    end
end

local function collectCycle()
    if isCollecting or not Config.Running then return end
    isCollecting = true

    local items = scanNearbyItems()
    if #items > 0 then
        Stats.StatusText = string.format("Mengambil %d Item di sekitar...", #items)
        for _, item in ipairs(items) do
            if not Config.Running then break end

            local myPos = getCharacterPosition()
            if myPos and item.Prompt and item.Prompt.Parent then
                local curDist = (myPos - item.Position).Magnitude
                if curDist <= (Config.MaxStuds + 5) then
                    -- Auto Teleport jika diaktifkan
                    if Config.AutoTeleport and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(item.Position + Vector3.new(0, 2, 0))
                        task.wait(0.03)
                    end

                    local ok = triggerPickup(item.Prompt, item.Part)
                    if ok then
                        Stats.TotalCollected = Stats.TotalCollected + 1
                        Stats.LastCollected = item.DisplayName
                        if item.ItemType == "CRYSTAL" then
                            Stats.CrystalCount = Stats.CrystalCount + 1
                        else
                            Stats.RuneCount = Stats.RuneCount + 1
                        end
                        
                        table.insert(_G.AutoCollectLogs, 1, string.format("[%s] %s (%.1fm)", item.ItemType, item.DisplayName, curDist))
                        if #_G.AutoCollectLogs > 40 then table.remove(_G.AutoCollectLogs) end
                    end

                    if Config.CollectDelay > 0 then task.wait(Config.CollectDelay) end
                end
            end
        end
    else
        Stats.StatusText = string.format("Scanning Item (%ds)...", Config.MaxStuds)
    end

    isCollecting = false
end

local loopThread = nil
local function startCollectLoop()
    if loopThread then return end
    loopThread = task.spawn(function()
        while Config.Running do
            pcall(collectCycle)
            task.wait(Config.CollectDelay > 0 and Config.CollectDelay or 0.05)
        end
        loopThread = nil
    end)
end

