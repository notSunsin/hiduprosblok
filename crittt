    isMin = not isMin
    if isMin then
        TweenService:Create(Main, TweenInfo.new(0.2), { Size = UDim2.new(0, 420, 0, 46) }):Play()
        TabNav.Visible = false; CollectorPage.Visible = false; TrackPage.Visible = false; DupePage.Visible = false; PlayerPage.Visible = false
