        local emptyLbl = mkLbl(bpScroll, searchQ == "" and "Tas Anda sedang kosong..." or "Tidak ada crystal yang cocok.", 11, false, C.MUTED, Enum.TextXAlignment.Center)
        emptyLbl.Size = UDim2.new(1, 0, 0, 30); emptyLbl.AutomaticSize = Enum.AutomaticSize.None
    end
end

