local function renderBackpackList()
    local inv = scanBackpack()
    local searchQ = bpSearchBox.Text:gsub("^%s+", ""):gsub("%s+$", ""):lower()

    local sumParts = {}
    for _, rk in ipairs({"QUASAR", "PULSAR", "EMPYREAN", "MYTHIC", "LEGENDARY"}) do
        local c = inv.ByRarity[rk] or 0
        if c > 0 then table.insert(sumParts, string.format("%s: %d", rk:sub(1,1)..rk:sub(2):lower(), c)) end
    end
    bpSummaryLbl.Text = string.format("Total di Tas: %d Crystal (%s)", inv.Total, #sumParts > 0 and table.concat(sumParts, ", ") or "Kosong/Common")

    for _, ch in ipairs(bpScroll:GetChildren()) do
        if ch:IsA("Frame") then ch:Destroy() end
    end

    local displayCount = 0
    for i, itemData in ipairs(inv.List) do
        if searchQ == "" or itemData.Name:lower():find(searchQ, 1, true) or itemData.Rarity:lower():find(searchQ, 1, true) then
            displayCount = displayCount + 1
            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 24); row.BackgroundColor3 = C.PANEL; row.LayoutOrder = i; row.Parent = bpScroll
            mkCorner(row, 5)

            local rBadge = Instance.new("Frame")
            rBadge.Size = UDim2.new(0, 68, 1, -4); rBadge.Position = UDim2.new(0, 2, 0, 2); rBadge.BackgroundColor3 = C.CARD; rBadge.Parent = row
            mkCorner(rBadge, 4)

            local rBadgeLbl = mkLbl(rBadge, itemData.Rarity, 9, true, RarityColors[itemData.Rarity] or C.TEXT, Enum.TextXAlignment.Center)
            rBadgeLbl.Size = UDim2.new(1, 0, 1, 0); rBadgeLbl.AutomaticSize = Enum.AutomaticSize.None

            local nameLbl = mkLbl(row, itemData.Name, 11, false, C.TEXT)
            nameLbl.Position = UDim2.new(0, 76, 0, 0); nameLbl.Size = UDim2.new(1, -120, 1, 0); nameLbl.TextTruncate = Enum.TextTruncate.AtEnd; nameLbl.AutomaticSize = Enum.AutomaticSize.None

            local countBadge = mkLbl(row, "x" .. tostring(itemData.Count), 11, true, Color3.fromRGB(74, 222, 128), Enum.TextXAlignment.Right)
            countBadge.Position = UDim2.new(1, -42, 0, 0); countBadge.Size = UDim2.new(0, 36, 1, 0); countBadge.AutomaticSize = Enum.AutomaticSize.None
