local function getRemote(name)
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    return remotes and remotes:FindFirstChild(name)
end

local function getCharacterPosition()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    return hrp and hrp.Position
end

-- Deteksi apakah prompt adalah Rune yang cocok dengan daftar
local function parseRuneInfo(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return nil, nil end
    local parent = prompt.Parent
    if not parent then return nil, nil end

    -- Kumpulkan seluruh string penanda nama
    local fullText = (prompt.ObjectText .. " " .. prompt.ActionText .. " " .. parent.Name):lower()
    
    local attrName = parent:GetAttribute("RuneName") or parent:GetAttribute("DisplayName") or parent:GetAttribute("CrystalName")
    if attrName then
        fullText = fullText .. " " .. tostring(attrName):lower()
    end

    for _, desc in ipairs(parent:GetChildren()) do
        if desc:IsA("BillboardGui") then
            for _, lbl in ipairs(desc:GetDescendants()) do
                if lbl:IsA("TextLabel") and lbl.Text ~= "" then
                    fullText = fullText .. " " .. lbl.Text:lower()
                end
            end
        end
    end

    -- Cek kecocokan dengan 9 daftar Rune
    for _, rune in ipairs(RuneList) do
        if fullText:find(rune.keyword, 1, true) then
            return rune.remote, rune.display
        end
    end

    return nil, nil
end

-- ============================================================
--  COLLECTION LOGIC
-- ============================================================
local function triggerPickup(prompt, part)
    if not prompt or not prompt.Parent then return false end
    if Config.InstantHold then prompt.HoldDuration = 0 end

    -- Trigger server remote bypass
    if Config.ServerRemote and part then
        pcall(function()
            local rem = getRemote("CrystalHoldComplete")
            if rem then rem:FireServer(part) end
        end)
    end

    -- Executor fast hook
    if typeof(fireproximityprompt) == "function" then
        pcall(function() fireproximityprompt(prompt, 0) end)
        return true
    end

    -- Standar input hold
    return pcall(function()
        prompt:InputHoldBegin()
        task.wait(Config.InstantHold and 0.01 or (prompt.HoldDuration > 0 and prompt.HoldDuration or 0.01))
        prompt:InputHoldEnd()
    end)
end

local function scanNearbyRunes()
    local charPos = getCharacterPosition()
    if not charPos then return {} end

    local runesFound = {}
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled then
            local runeRemoteKey, runeDisplayName = parseRuneInfo(prompt)
            
            -- Pastikan ini Rune dan sedang di-checklist ON oleh user
            if runeRemoteKey and Config.EnabledRunes[runeRemoteKey] then
                local part = prompt.Parent
                local pos = nil
                if part:IsA("BasePart") then pos = part.Position
                elseif part:IsA("Model") and part.PrimaryPart then pos = part.PrimaryPart.Position
                elseif part:IsA("Attachment") then pos = part.WorldPosition
                elseif part:IsA("Model") then
                    local fp = part:FindFirstChildWhichIsA("BasePart", true)
                    if fp then pos = fp.Position end
                end

                if pos then
                    local dist = (charPos - pos).Magnitude
                    if dist <= Config.MaxStuds then
                        table.insert(runesFound, {
                            Prompt      = prompt,
                            Part        = part,
                            Position    = pos,
                            Distance    = dist,
                            RuneKey     = runeRemoteKey,
                            DisplayName = runeDisplayName
                        })
                    end
                end
            end
        end
    end

    if Config.SortByDistance then
        table.sort(runesFound, function(a, b) return a.Distance < b.Distance end)
    end

    return runesFound
end

local isCollecting = false
local startBtnRef = nil

local function stopRuneLoop()
    Config.Running = false
    Stats.StatusText = "IDLE (Dihentikan)"
    if startBtnRef then
        startBtnRef.Text = "START AUTO COLLECT RUNE"
        startBtnRef.BackgroundColor3 = Color3.fromRGB(34, 197, 94)
    end
end

local function runeCycle()
    if isCollecting or not Config.Running then return end
    isCollecting = true

    local runes = scanNearbyRunes()
    if #runes > 0 then
        Stats.StatusText = string.format("Mengambil %d Rune di sekitar...", #runes)
        for _, rData in ipairs(runes) do
            if not Config.Running then break end

            local myPos = getCharacterPosition()
            if myPos and rData.Prompt and rData.Prompt.Parent then
                local curDist = (myPos - rData.Position).Magnitude
                if curDist <= (Config.MaxStuds + 5) then
                    -- Auto Teleport ke Rune jika diaktifkan
                    if Config.AutoTeleport and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(rData.Position + Vector3.new(0, 2, 0))
                        task.wait(0.03)
                    end

                    local ok = triggerPickup(rData.Prompt, rData.Part)
                    if ok then
                        Stats.TotalCollected = Stats.TotalCollected + 1
                        Stats.LastCollected = rData.DisplayName .. " Rune"
                        Stats.RuneCounts[rData.RuneKey] = (Stats.RuneCounts[rData.RuneKey] or 0) + 1
                        
                        table.insert(_G.RuneCollectLogs, 1, string.format("[RUNE] %s (%.1fm)", rData.DisplayName, curDist))
                        if #_G.RuneCollectLogs > 40 then table.remove(_G.RuneCollectLogs) end
                    end

                    if Config.CollectDelay > 0 then task.wait(Config.CollectDelay) end
                end
            end
        end
    else
        Stats.StatusText = string.format("Scanning Rune (%ds)...", Config.MaxStuds)
    end

    isCollecting = false
end

local loopThread = nil
local function startRuneLoop()
    if loopThread then return end
    loopThread = task.spawn(function()
        while Config.Running do
            pcall(runeCycle)
            task.wait(Config.CollectDelay > 0 and Config.CollectDelay or 0.05)
        end
        loopThread = nil
    end)
end

