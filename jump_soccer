local isDragging = false
sliderThumb.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        isDragging = true
    end
end)
UserInputService.InputEnded:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        isDragging = false
    end
end)
UserInputService.InputChanged:Connect(function(inp)
    if not isDragging then return end
    if inp.UserInputType ~= Enum.UserInputType.MouseMovement and inp.UserInputType ~= Enum.UserInputType.Touch then return end
    local tPos  = sliderTrack.AbsolutePosition
    local tSize = sliderTrack.AbsoluteSize
    local ratio = math.clamp((inp.Position.X - tPos.X) / tSize.X, 0, 1)
    local calcSpeed = math.floor(FlyConfig.MinSpeed + ratio * (FlyConfig.MaxSpeed - FlyConfig.MinSpeed))
    setFlySpeed(calcSpeed, true)
end)

flySpeedBox.FocusLost:Connect(function()
    local val = tonumber(flySpeedBox.Text)
    if val and val > 0 then
        setFlySpeed(math.floor(val), true)
        fsbStroke.Color = C.BLUE
    else
        flySpeedBox.Text = tostring(FlyConfig.Speed)
        fsbStroke.Color = C.BORDER
    end
end)

