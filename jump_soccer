local function setFlySpeed(newSpeed, updateBox)
    newSpeed = math.clamp(newSpeed, 1, 2000)
    FlyConfig.Speed = newSpeed
    if updateBox then flySpeedBox.Text = tostring(newSpeed) end
    local ratio = math.clamp((newSpeed - FlyConfig.MinSpeed) / (FlyConfig.MaxSpeed - FlyConfig.MinSpeed), 0, 1)
    sliderFill.Size      = UDim2.new(ratio, 0, 1, 0)
    sliderThumb.Position = UDim2.new(ratio, 0, 0.5, 0)
end

local function mkPresetBtn(label, spd)
    local b = Instance.new("TextButton")
    b.Size             = UDim2.new(0.25, -4, 1, 0)
    b.BackgroundColor3 = C.PANEL
    b.Text             = label
    b.Font             = Enum.Font.GothamBold
    b.TextSize         = 10
    b.TextColor3       = C.TEXT
    b.Parent           = presetRow
    mkCorner(b, 5); mkStroke(b, C.BORDER, 1)
    b.MouseButton1Click:Connect(function()
        setFlySpeed(spd, true)
    end)
end

