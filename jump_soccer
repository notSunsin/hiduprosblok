    bPad.PaddingLeft   = UDim.new(0, 6)
    bPad.PaddingRight  = UDim.new(0, 6)
    bPad.PaddingBottom = UDim.new(0, 10)
    bPad.Parent        = Scroll

    tabPages[name] = Scroll
    return Scroll
end

local function switchTab(name)
    for tName, page in pairs(tabPages) do
        page.Visible = (tName == name)
    end
    for tName, btn in pairs(tabBtns) do
        local isAct = (tName == name)
        btn.BackgroundColor3 = isAct and C.TAB_ACT or C.TAB_INACT
        btn.TextColor3       = isAct and Color3.fromRGB(15, 15, 20) or C.MUTED
        local st = btn:FindFirstChildOfClass("UIStroke")
        if st then st.Color = isAct and C.ACCENT or C.BORDER end
    end
end

