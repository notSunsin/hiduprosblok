-- Dapatkan Posisi Karakter
local function getCharacterPosition()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    return hrp and hrp.Position
end

-- Deteksi apakah sebuah prompt / instance adalah Rune
local function isRunePrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end
    
    local parent = prompt.Parent
    if not parent then return false end

    local pName = parent.Name:lower()
    local pObjText = prompt.ObjectText:lower()
    local pActText = prompt.ActionText:lower()

    -- Cek kata kunci Rune atau Pickup/Ambil
    local hasRuneWord = pName:find("rune") or pObjText:find("rune") or parent:GetAttribute("RuneName") or parent:GetAttribute("RuneId")
    local hasActionWord = pActText:find("ambil") or pActText:find("pickup") or pActText:find("collect") or pActText:find("take")

    -- Cek jika di parent atau anak terdapat BillboardGui bertuliskan "Rune"
    if not hasRuneWord then
        for _, desc in ipairs(parent:GetChildren()) do
            if desc:IsA("BillboardGui") then
                for _, textLabel in ipairs(desc:GetDescendants()) do
                    if textLabel:IsA("TextLabel") and textLabel.Text:lower():find("rune") then
                        hasRuneWord = true
                        break
                    end
                end
            end
            if hasRuneWord then break end
        end
    end

    return hasRuneWord or (hasActionWord and (pName:find("drop") or pName:find("crystal") or pObjText:find("rune")))
end

-- Dapatkan Nama dan Rarity dari Rune
local function getRuneInfo(prompt)
    local parent = prompt.Parent
    local name = prompt.ObjectText ~= "" and prompt.ObjectText or parent.Name
    local rarity = "UMUM"

    -- Deteksi dari BillboardGui jika ada
    if parent then
        for _, desc in ipairs(parent:GetChildren()) do
            if desc:IsA("BillboardGui") then
                for _, lbl in ipairs(desc:GetDescendants()) do
                    if lbl:IsA("TextLabel") then
                        local t = lbl.Text:upper()
                        if t:find("MYTHIC") then rarity = "MYTHIC"
                        elseif t:find("LEGENDARIS") or t:find("LEGENDARY") then rarity = "LEGENDARIS"
                        elseif t:find("RARE") then rarity = "RARE"
                        elseif t:find("UNCOMMON") then rarity = "UNCOMMON"
                        elseif t:find("UMUM") or t:find("COMMON") then rarity = "UMUM"
                        elseif t:find("SECRET") then rarity = "SECRET"
                        end
                        if lbl.Text ~= "" and not name:find("Rune") and lbl.Text:find("Rune") then
                            name = lbl.Text
                        end
                    end
                end
            end
        end
    end

    -- Fallback cek dari teks nama
    local uname = name:upper()
    if uname:find("MYTHIC") then rarity = "MYTHIC"
    elseif uname:find("LEGENDARIS") or uname:find("LEGENDARY") then rarity = "LEGENDARIS"
    elseif uname:find("RARE") then rarity = "RARE"
    elseif uname:find("UNCOMMON") then rarity = "UNCOMMON"
    elseif uname:find("UMUM") or uname:find("COMMON") then rarity = "UMUM"
    end

    return name, rarity
end

-- Eksekusi trigger ProximityPrompt
local function triggerPrompt(prompt)
    if not prompt or not prompt.Parent then return false end
    
    if Config.InstantHold then
        prompt.HoldDuration = 0
    end

    -- 1. Gunakan fireproximityprompt jika executor mendukung
    if typeof(fireproximityprompt) == "function" then
        pcall(function()
            fireproximityprompt(prompt, 0)
        end)
        return true
    end

    -- 2. Fallback input hold simulasi
    local success = pcall(function()
        prompt:InputHoldBegin()
        if prompt.HoldDuration > 0 and not Config.InstantHold then
            task.wait(prompt.HoldDuration)
        else
            task.wait(0.02)
        end
        prompt:InputHoldEnd()
    end)

    return success
end

-- Cari semua dropped runes dalam radius karakter
local function getNearbyRunes()
    local charPos = getCharacterPosition()
    if not charPos then return {} end

    local foundRunes = {}

    -- Scan semua ProximityPrompt di workspace
    for _, prompt in ipairs(Workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") and prompt.Enabled and isRunePrompt(prompt) then
            local part = prompt.Parent
            local pos = nil
            if part:IsA("BasePart") then
                pos = part.Position
            elseif part:IsA("Model") and part.PrimaryPart then
                pos = part.PrimaryPart.Position
            elseif part:IsA("Attachment") then
                pos = part.WorldPosition
            elseif part:IsA("Model") then
                local firstPart = part:FindFirstChildWhichIsA("BasePart", true)
                if firstPart then pos = firstPart.Position end
            end

            if pos then
                local dist = (charPos - pos).Magnitude
                if dist <= Config.MaxStuds then
                    local name, rarity = getRuneInfo(prompt)
                    if Config.EnabledRarities[rarity] ~= false then
                        table.insert(foundRunes, {
                            Prompt   = prompt,
                            Position = pos,
                            Distance = dist,
                            Name     = name,
                            Rarity   = rarity,
                        })
                    end
                end
            end
        end
    end

    -- Sortir berdasarkan jarak terdekat
    if Config.SortByDistance then
        table.sort(foundRunes, function(a, b)
            return a.Distance < b.Distance
        end)
    end

    return foundRunes
end

-- ============================================================
--  MAIN COLLECTION CYCLE
-- ============================================================
local isCollecting = false

local function collectRunesCycle()
    if isCollecting or not Config.Running then return end
    isCollecting = true

    local runes = getNearbyRunes()
    if #runes > 0 then
        Stats.StatusText = ("Mengambil %d Rune di sekitar..."):format(#runes)
        for _, runeData in ipairs(runes) do
            if not Config.Running then break end
            
            -- Re-check jarak (jika karakter bergerak)
            local myPos = getCharacterPosition()
            if myPos and runeData.Prompt and runeData.Prompt.Parent then
                local curDist = (myPos - runeData.Position).Magnitude
                if curDist <= Config.MaxStuds then
                    -- Teleport opsional jika diaktifkan
                    if Config.AutoTeleport and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                        LocalPlayer.Character.HumanoidRootPart.CFrame = CFrame.new(runeData.Position + Vector3.new(0, 2, 0))
                        task.wait(0.04)
                    end

                    -- Trigger ambil
                    local ok = triggerPrompt(runeData.Prompt)
                    if ok then
                        Stats.TotalCollected = Stats.TotalCollected + 1
                        Stats.LastCollected = runeData.Name
                        _G.RuneCollectLogs = _G.RuneCollectLogs or {}
                        table.insert(_G.RuneCollectLogs, 1, string.format("[+%s] %s (%.1fm)", runeData.Rarity, runeData.Name, curDist))
                        if #_G.RuneCollectLogs > 60 then table.remove(_G.RuneCollectLogs) end
                    end

                    if Config.CollectDelay > 0 then
                        task.wait(Config.CollectDelay)
                    end
                end
            end
        end
    else
        Stats.StatusText = "Menunggu Crystal di sekitar (" .. tostring(Config.MaxStuds) .. " studs)..."
    end

    isCollecting = false
end

-- Loop runner
local loopThread = nil
local function startLoop()
    if loopThread then return end
    loopThread = task.spawn(function()
        while Config.Running do
            pcall(collectRunesCycle)
            task.wait(Config.CollectDelay > 0 and Config.CollectDelay or 0.1)
        end
        loopThread = nil
        Stats.StatusText = "IDLE (Dihentikan)"
    end)
end

local function stopLoop()
    Config.Running = false
    Stats.StatusText = "IDLE (Dihentikan)"
end

